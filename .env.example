# Zkopíruj tento soubor jako .env a vyplň hodnoty:  cp .env.example .env
# Proměnné aplikace se píšou plným názvem NANOFAKTURA_* (seznam všech je v README → Konfigurace).
# Starší krátké názvy (PUBLIC_URL, SMTP_HOST …) stále fungují, ale plný název má přednost.

# ── Docker / infrastruktura (jen pro docker compose) ────────────────────────────
POSTGRES_PASSWORD=zmen_toto_na_silne_heslo
# Port a rozhraní, na kterém bude aplikace dostupná (výchozí jen localhost — před ni patří reverzní proxy)
APP_PORT=8080
# APP_BIND=0.0.0.0
# Jen pro docker-compose.traefik.yml:
# DOMAIN=nanofaktura.cz
# CERT_RESOLVER=letsencrypt
# TRAEFIK_NETWORK=proxy

# ── Aplikace ─────────────────────────────────────────────────────────────────────
# Adresa, na které aplikaci otevíráte (odkazy v e-mailech; https:// zapne Secure cookie a HSTS)
NANOFAKTURA_PUBLIC_URL=http://localhost:8080

# Token pro první registraci — náhodný řetězec (např. `openssl rand -hex 16`), zadáte ho při zakládání
# prvního účtu. Chrání čerstvou instanci před cizí registrací.
NANOFAKTURA_SETUP_TOKEN=

# Klíč šifrující uložená tajemství (32 bajtů base64/hex, např. `openssl rand -base64 32`).
# Prázdný = vygeneruje se do datového volume (/data/secret.key) — zálohujte ho spolu s databází.
NANOFAKTURA_SECRET_KEY=

# ── E-mail ───────────────────────────────────────────────────────────────────────
# Prázdný SMTP host = e-maily se jen vypisují do logu.
# Google Workspace: smtp.gmail.com, 587, starttls, heslo aplikace (ne běžné heslo)
NANOFAKTURA_SMTP_HOST=
NANOFAKTURA_SMTP_PORT=587
NANOFAKTURA_SMTP_TLS=starttls
NANOFAKTURA_SMTP_USER=
NANOFAKTURA_SMTP_PASSWORD=
NANOFAKTURA_MAIL_FROM="NanoFaktura <faktury@example.cz>"
# Podpis DKIM (volitelné; všechny tři, nebo žádný). Klíč: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# NANOFAKTURA_DKIM_DOMAIN=example.cz
# NANOFAKTURA_DKIM_SELECTOR=nf
# NANOFAKTURA_DKIM_PRIVATE_KEY_FILE=/data/dkim.pem   # nebo NANOFAKTURA_DKIM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n…"

# ── Správa instance ──────────────────────────────────────────────────────────────
# E-maily správců (čárkou). Práva platí až po ověření e-mailu (Nastavení → Můj profil → Ověřit e-mail).
NANOFAKTURA_ADMIN_EMAILS=

# ── Volitelné ────────────────────────────────────────────────────────────────────
# NANOFAKTURA_TRUSTED_PROXIES=172.18.0.0/16   # podsíť reverzní proxy (Traefik overlay má vlastní výchozí)
# NANOFAKTURA_DB_LOG=error                    # silent | error | warn | info
# NANOFAKTURA_ALLOW_SIGNUP=false              # povolit registraci i po prvním uživateli
