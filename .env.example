# Zkopíruj tento soubor jako .env a vyplň hodnoty
# cp .env.example .env

# Povinné — heslo pro PostgreSQL
POSTGRES_PASSWORD=zmen_toto_na_silne_heslo

# Volitelné — port na kterém poběží aplikace (výchozí 8080)
APP_PORT=8080

# Veřejná adresa aplikace (odkazy v e-mailech, obnova hesla, bezpečnostní klíče)
PUBLIC_URL=https://nanofaktura.cz

# E-mail — prázdný SMTP_HOST = e-maily se jen vypisují do logu
# Google Workspace: smtp.gmail.com, 587, starttls, heslo aplikace (ne běžné heslo)
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="NanoFaktura <faktury@example.cz>"
