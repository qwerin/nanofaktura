# Zkopíruj tento soubor jako .env a vyplň hodnoty
# cp .env.example .env

# Povinné — heslo pro PostgreSQL
POSTGRES_PASSWORD=zmen_toto_na_silne_heslo

# Adresa, na které aplikaci otevíráte (https:// zapne Secure cookie a HSTS)
PUBLIC_URL=http://localhost:8080

# Token pro první registraci — vyplňte náhodný řetězec (např. `openssl rand -hex 16`),
# zadáte ho při zakládání prvního účtu. Chrání čerstvou instanci před cizí registrací.
SETUP_TOKEN=

# Klíč šifrující uložená tajemství (32 bajtů base64/hex, např. `openssl rand -base64 32`).
# Prázdný = vygeneruje se do datového volume (/data/secret.key) — zálohujte ho spolu s databází.
SECRET_KEY=

# Volitelné — port na kterém poběží aplikace (výchozí 8080) a adresa rozhraní (výchozí jen localhost)
APP_PORT=8080
# APP_BIND=0.0.0.0
